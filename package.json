{
  "name": "luma-lang",
  "version": "1.2.0",
  "description": "Luma — a small, expressive programming language: hand-written lexer, Pratt parser and tree-walking interpreter in TypeScript, with zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "belaSimoes",
  "keywords": [
    "programming-language",
    "interpreter",
    "compiler",
    "lexer",
    "parser",
    "pratt-parser",
    "typescript",
    "repl",
    "pattern-matching",
    "debugger",
    "time-travel-debugging"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "luma": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/cli.ts",
    "repl": "node src/cli.ts",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:watch": "node --test --watch \"test/**/*.test.ts\"",
    "playground": "npm run build && node scripts/serve.ts",
    "examples": "node scripts/run-examples.ts",
    "prepublishOnly": "npm run build",
    "bench": "node bench/run.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belaSimoes/luma-lang.git"
  },
  "bugs": {
    "url": "https://github.com/belaSimoes/luma-lang/issues"
  },
  "homepage": "https://github.com/belaSimoes/luma-lang#readme"
}
