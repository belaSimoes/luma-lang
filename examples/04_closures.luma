// Functions are values, and they carry their environment with them.

// A counter: `n` outlives the call to `counter()` because the inner function
// still refers to it.
fn counter(start) {
  let n = start;
  fn() {
    n = n + 1;
    n
  }
}

let tick = counter(0);
let other = counter(100);

print(tick(), tick(), tick());   // independent state...
print(other());                  // ...per closure

// Partial application falls out of nested functions.
fn adder(x) {
  fn(y) { x + y }
}

let add10 = adder(10);
print("add10(5) =", add10(5));

// Function composition, built from nothing but closures.
fn compose(f, g) {
  fn(x) { f(g(x)) }
}

fn double(n) { n * 2 }
fn increment(n) { n + 1 }

let double_then_increment = compose(increment, double);
print("compose:", map([1, 2, 3], double_then_increment));

// A tiny object, made of a hash of closures over shared state.
fn new_stack() {
  let items = [];
  {
    "push": fn(item) { items = push(items, item); nil },
    "pop":  fn() { let top = last(items); items = pop(items); top },
    "size": fn() { len(items) }
  }
}

let stack = new_stack();
stack.push("a");
stack.push("b");
print("popped:", stack.pop(), "| size:", stack.size());
