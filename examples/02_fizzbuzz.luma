// FizzBuzz, twice: once imperatively, once as a pipeline.

fn fizzbuzz(n) {
  if (n % 15 == 0) {
    "FizzBuzz"
  } else if (n % 3 == 0) {
    "Fizz"
  } else if (n % 5 == 0) {
    "Buzz"
  } else {
    str(n)
  }
}

print("-- loop --");
for (n in range(1, 16)) {
  print(fizzbuzz(n));
}

print("-- pipeline --");
print(join(map(range(1, 16), fizzbuzz), " "));
